@echo off
REM rgytui installer for Windows
REM Double-click this file or run from PowerShell.
REM No admin elevation required ? everything installs to user directories.
REM Uses Base64-encoded PowerShell to avoid cmd.exe quoting/escaping issues.

powershell -NoProfile -ExecutionPolicy RemoteSigned -EncodedCommand 
if %errorlevel% neq 0 (
    echo.
    echo The installer encountered an error. Check the output above.
    pause
    exit /b 1
)

REM Self-delete installer on success
del "%~f0"