@echo off
REM rgytui installer for Windows
REM Double-click this file to install everything.
REM Uses Base64-encoded PowerShell to avoid cmd.exe quoting/escaping issues.
REM Self-elevates to admin if needed (uses --admin flag to prevent loop).

if not "%1"=="--admin" (
    powershell -NoProfile -Command "Start-Process cmd -ArgumentList '/c \"\"%~f0\"\" --admin' -Verb RunAs -Wait"
    goto :eof
)

powershell -NoProfile -ExecutionPolicy RemoteSigned -EncodedCommand 
if %errorlevel% neq 0 (
    echo The installer encountered an error.
    pause
    exit /b 1
)
