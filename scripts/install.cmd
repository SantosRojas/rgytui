@echo off
REM rgytui installer for Windows
REM Run from PowerShell:
REM   iwr -Uri https://raw.githubusercontent.com/SantosRojas/rgytui/master/scripts/install.cmd -OutFile install.cmd -UseBasicParsing; .\install.cmd
REM
REM No admin elevation required ??? everything installs to user directories.
REM
REM The PowerShell script is embedded as Base64 between two marker lines.
REM At runtime we extract it with a short PowerShell one-liner,
REM decode with certutil, and execute it.

setlocal
set "TMPFILE=%TEMP%\rgytui-install.ps1"
set "B64FILE=%TEMP%\rgytui-install.b64"

REM Extract Base64 between markers (short PS command, no line-length issues)
powershell -NoProfile -Command ^
  "$c=Get-Content '%~f0' -Raw;" ^
  "$m=[regex]::Match($c,'__BEGIN_SCRIPT__\r?\n(.*)\r?\n__END_SCRIPT__','Singleline');" ^
  "[System.IO.File]::WriteAllText('%B64FILE%',$m.Groups[1].Value.Trim())"

REM Decode Base64 -> PowerShell script
certutil -decode "%B64FILE%" "%TMPFILE%" >nul 2>&1
if %errorlevel% neq 0 (
    echo Failed to decode installer script. The download may be corrupted.
    echo Try downloading again.
    pause
    exit /b 1
)

REM Run the installer
powershell -NoProfile -ExecutionPolicy RemoteSigned -File "%TMPFILE%"
set "EXIT_CODE=%errorlevel%"

REM Cleanup temp files
del "%B64FILE%" >nul 2>&1
del "%TMPFILE%" >nul 2>&1

if %EXIT_CODE% neq 0 (
    echo.
    echo The installer encountered an error. Check the output above.
    pause
    exit /b 1
)

REM Self-delete installer on success
del "%~f0"

