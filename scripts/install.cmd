set "EXIT_CODE=%errorlevel%"

REM Cleanup temp files
del "%B64FILE%" >nul 2>&1
del "%TMPFILE%" >nul 2>&1

if %EXIT_CODE% neq 0 (
echo.
echo The installer encountered an error. Check the output above.
pause
exit /b 1
